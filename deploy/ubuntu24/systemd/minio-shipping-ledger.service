[Unit]
Description=MinIO for AI Shipping Ledger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minio-shipping
Group=minio-shipping
EnvironmentFile=/etc/ai-shipping-ledger/minio.env
ExecStart=/usr/local/bin/minio server --address 127.0.0.1:9000 --console-address 127.0.0.1:9001 /var/lib/ai-shipping-ledger/minio
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-shipping-ledger/minio

[Install]
WantedBy=multi-user.target
