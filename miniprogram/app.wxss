page {
  background: #f4f7f6;
  color: #17231f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.container {
  padding: 28rpx 24rpx 44rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 28rpx rgba(23, 54, 43, 0.045);
}

.title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 760;
  letter-spacing: -1rpx;
  margin-bottom: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 32rpx 2rpx 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-link {
  color: #176b4d;
  font-size: 24rpx;
}

.muted {
  color: #7b8883;
  font-size: 24rpx;
  line-height: 1.55;
}

.small {
  font-size: 22rpx;
}

.primary-button,
.secondary-button,
.ghost-button {
  margin: 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.primary-button {
  background: #176b4d;
  color: #ffffff;
  line-height: 92rpx;
}

.primary-button[disabled] {
  background: #a9bbb4;
  color: #f4f7f6;
}

.secondary-button {
  background: #eef6f2;
  color: #176b4d;
  line-height: 84rpx;
}

.ghost-button {
  background: #ffffff;
  color: #41504a;
  border: 1rpx solid #dfe6e2;
  line-height: 82rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 650;
  box-sizing: border-box;
  white-space: nowrap;
}

.badge-success {
  background: #e8f5ee;
  color: #176b4d;
}

.badge-warning {
  background: #fff3d9;
  color: #9a6200;
}

.badge-info {
  background: #eaf1fb;
  color: #315f9c;
}

.badge-neutral {
  background: #eff2f1;
  color: #65716d;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.divider {
  height: 1rpx;
  background: #edf1ef;
  margin: 22rpx 0;
}

.input-shell {
  background: #f7f9f8;
  border: 1rpx solid #e0e7e3;
  border-radius: 16rpx;
  min-height: 82rpx;
  box-sizing: border-box;
}

.empty-state {
  text-align: center;
  padding-top: 48rpx;
  padding-bottom: 48rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 680;
  margin-bottom: 8rpx;
}

.notice-warning {
  background: #fff9eb;
  border-color: #f1dfb6;
}
