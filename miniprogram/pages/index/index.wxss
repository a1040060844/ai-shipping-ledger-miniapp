.hero-subtitle {
  margin-top: 10rpx;
}

.upload-button {
  margin-top: 30rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx 18rpx;
  text-align: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.empty-state {
  text-align: center;
  line-height: 1.8;
}

.shipment-card {
  border: 1rpx solid #eceef1;
}

.shipment-factory {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 0;
}

.shipment-summary {
  font-size: 30rpx;
  font-weight: 600;
  margin: 18rpx 0 8rpx;
}
