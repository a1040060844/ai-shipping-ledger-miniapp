.summary-card {
  background: #163f31;
  color: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 38rpx rgba(17, 72, 52, 0.17);
}

.summary-top {
  align-items: center;
}

.summary-date {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
}

.summary-factory {
  font-size: 34rpx;
  font-weight: 760;
  line-height: 1.35;
  margin-top: 22rpx;
}

.summary-numbers {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.summary-number-block {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.summary-number {
  font-size: 46rpx;
  font-weight: 780;
}

.summary-unit {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.72);
}

.summary-separator {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 0 28rpx;
}

.summary-incomplete {
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.1);
}

.summary-incomplete-title {
  font-size: 29rpx;
  font-weight: 700;
}

.summary-incomplete-desc {
  margin-top: 7rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}

.summary-docno {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.review-banner {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fff7e5;
  border: 1rpx solid #efdcae;
}

.review-icon {
  flex: 0 0 auto;
  width: 46rpx;
  height: 46rpx;
  border-radius: 15rpx;
  background: #efd18e;
  color: #805200;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.review-content {
  flex: 1;
}

.review-title {
  color: #744b00;
  font-size: 26rpx;
  font-weight: 720;
}

.review-desc {
  color: #96723c;
  font-size: 22rpx;
  line-height: 1.55;
  margin-top: 6rpx;
}

.source-action {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  background: #ffffff;
  border: 1rpx solid #e4ebe7;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.source-action-title {
  font-size: 27rpx;
  font-weight: 700;
}

.source-action-desc {
  color: #7d8984;
  font-size: 21rpx;
  margin-top: 6rpx;
}

.source-action-arrow {
  color: #799087;
  font-size: 42rpx;
}

.autosave-note {
  color: #789087;
  font-size: 22rpx;
}

.document-card {
  padding-top: 8rpx;
}

.field-block {
  margin-top: 20rpx;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.field-label {
  font-size: 22rpx;
  color: #6f7d77;
  margin-bottom: 9rpx;
}

.field-review-label {
  color: #9a6200;
  font-size: 20rpx;
  font-weight: 650;
  margin-bottom: 9rpx;
}

.field-input {
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  background: #f7f9f8;
  border: 1rpx solid #e0e7e3;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  color: #1f2c27;
}

.field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.field-warning .field-label {
  color: #936000;
}

.field-warning .field-input {
  background: #fff9ea;
  border-color: #e7c97d;
  box-shadow: 0 0 0 2rpx rgba(231, 201, 125, 0.12);
}

.item-card {
  background: #ffffff;
  border: 1rpx solid #e5ebe8;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 28rpx rgba(23, 54, 43, 0.04);
}

.item-card-warning {
  border-color: #ead7aa;
}

.item-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.item-count {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  background: #edf4f0;
  color: #176b4d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 780;
}

.item-title-wrap {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 29rpx;
  font-weight: 720;
  line-height: 1.45;
}

.item-subtitle {
  margin-top: 5rpx;
  color: #87928e;
  font-size: 22rpx;
}

.source-text {
  margin-top: 20rpx;
  background: #f6f8f7;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  color: #5e6b66;
  font-size: 23rpx;
  line-height: 1.65;
}

.source-label {
  color: #8c9692;
  font-size: 20rpx;
  margin-bottom: 5rpx;
}

.quantity-panel {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f4f8f6;
}

.quantity-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #40534b;
}

.quantity-grid .field-block {
  margin-top: 16rpx;
}

.number-input {
  font-size: 32rpx;
  font-weight: 720;
}

.calculation {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #dfe8e3;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.calculation-formula {
  color: #728079;
  font-size: 22rpx;
}

.calculation-result {
  color: #176b4d;
  font-size: 32rpx;
  font-weight: 780;
  white-space: nowrap;
}

.incomplete-calc {
  display: block;
  color: #946200;
  font-size: 24rpx;
}

.save-footnote {
  margin-top: 26rpx;
  padding: 24rpx 20rpx 16rpx;
  text-align: center;
}

.save-footnote-title {
  font-size: 25rpx;
  font-weight: 700;
  margin-bottom: 7rpx;
}
