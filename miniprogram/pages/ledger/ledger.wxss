.ledger-head {
  padding: 8rpx 4rpx 24rpx;
}

.search-shell {
  min-height: 84rpx;
  padding: 0 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8e5;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-mark {
  color: #75837d;
  font-size: 30rpx;
}

.search-input {
  flex: 1;
  height: 82rpx;
  font-size: 26rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.filter-pill {
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8e5;
  display: flex;
  align-items: center;
  color: #65736d;
  font-size: 23rpx;
  box-sizing: border-box;
}

.filter-pill-active {
  color: #176b4d;
  border-color: #c7e1d5;
  background: #edf7f2;
}

.status-tabs {
  margin-top: 18rpx;
  padding: 6rpx;
  background: #e9efec;
  border-radius: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
}

.status-tab {
  height: 66rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #718079;
  font-size: 24rpx;
  font-weight: 620;
}

.status-tab-active {
  background: #ffffff;
  color: #176b4d;
  box-shadow: 0 4rpx 12rpx rgba(25, 71, 54, 0.07);
}

.summary-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rpx;
  margin-top: 18rpx;
  background: #e8eeeb;
  border: 1rpx solid #e3e9e6;
  border-radius: 20rpx;
  overflow: hidden;
}

.summary-strip-item {
  background: #ffffff;
  padding: 20rpx 12rpx;
  text-align: center;
}

.summary-value {
  font-size: 30rpx;
  font-weight: 740;
}

.summary-label {
  color: #85918c;
  font-size: 20rpx;
  margin-top: 5rpx;
}

.ledger-row {
  background: #ffffff;
  border: 1rpx solid #e5ebe8;
  border-radius: 22rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
}

.ledger-top {
  align-items: flex-start;
}

.factory-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 710;
  line-height: 1.45;
}

.ledger-meta {
  color: #89958f;
  font-size: 21rpx;
  margin-top: 6rpx;
}

.numbers {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 29rpx;
  margin-top: 19rpx;
  color: #44524c;
}

.numbers .strong {
  color: #17231f;
  font-weight: 760;
}

.warning-text {
  color: #936000;
}

.dot {
  color: #b5bfbb;
}

.ledger-foot {
  margin-top: 18rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #edf1ef;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.review-fields {
  color: #976100;
  font-size: 21rpx;
  font-weight: 650;
}

.ledger-arrow {
  color: #91a09a;
  font-size: 34rpx;
}
