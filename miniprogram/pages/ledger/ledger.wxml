<view class="container">
  <view class="card ledger-summary">
    <view class="section-title">全部记录</view>
    <view class="summary-grid">
      <view>
        <view class="summary-value">{{summary.shipments}}</view>
        <view class="muted">发货单</view>
      </view>
      <view>
        <view class="summary-value">{{summary.cartons}}</view>
        <view class="muted">已确认箱数</view>
      </view>
      <view>
        <view class="summary-value">{{summary.units}}</view>
        <view class="muted">已确认件数</view>
      </view>
    </view>
    <view class="badge badge-warning" wx:if="{{summary.incompleteShipments > 0}}">{{summary.incompleteShipments}} 张单有数量待确认</view>
  </view>

  <view wx:if="{{shipments.length === 0}}" class="card empty-state">
    <view>暂无台账</view>
    <view class="muted">从“发货”页上传发货单后会自动记录。</view>
  </view>

  <view
    wx:for="{{shipments}}"
    wx:key="id"
    class="card ledger-row"
    data-id="{{item.id}}"
    bindtap="openDetail"
  >
    <view class="row">
      <view class="factory-name">{{item.factoryName}}</view>
      <view class="muted">{{item.shipmentDate}}</view>
    </view>
    <view class="numbers" wx:if="{{item.quantityStatus !== 'incomplete'}}">{{item.totalCartons}} 箱 · {{item.totalUnits}} 件</view>
    <view class="numbers" wx:else>已确认 {{item.knownCartons}} 箱 · {{item.knownUnits}} 件 · 待确认</view>
    <view class="muted">{{item.items.length}} 条原始商品明细</view>
  </view>
</view>
