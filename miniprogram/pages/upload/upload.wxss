.upload-page {
  padding-bottom: 56rpx;
}

.upload-head {
  padding: 8rpx 4rpx 26rpx;
}

.mode-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.source-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.source-card {
  min-height: 230rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8e5;
  box-sizing: border-box;
}

.camera-card {
  background: #eaf5ef;
  border-color: #d4e9df;
}

.source-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: #176b4d;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.file-icon {
  background: #52645d;
}

.source-title {
  font-size: 29rpx;
  font-weight: 720;
  margin-top: 22rpx;
}

.source-desc {
  color: #7c8884;
  font-size: 22rpx;
  margin-top: 7rpx;
}

.tips-card {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e7ece9;
}

.tips-title {
  font-size: 25rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.tips-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #65716d;
  font-size: 23rpx;
  line-height: 1.55;
  margin-top: 7rpx;
}

.tips-dot {
  flex: 0 0 auto;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #6ea68f;
  margin-top: 14rpx;
}

.file-section-head {
  margin-top: 32rpx;
}

.file-list {
  background: #ffffff;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  overflow: hidden;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  border-top: 1rpx solid #edf1ef;
}

.file-row:first-child {
  border-top: none;
}

.thumb,
.pdf-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  flex: 0 0 auto;
}

.pdf-thumb {
  background: #eff3f1;
  color: #52645d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.file-info {
  flex: 1;
  min-width: 0;
}

.file-name {
  font-size: 26rpx;
  font-weight: 680;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  color: #89948f;
  font-size: 21rpx;
  margin-top: 8rpx;
}

.remove-button {
  color: #9b5c52;
  font-size: 22rpx;
  padding: 10rpx 4rpx 10rpx 16rpx;
}

.privacy-note {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: #f0f6f3;
  border-radius: 20rpx;
}

.privacy-title {
  color: #315f4e;
  font-size: 24rpx;
  font-weight: 680;
  margin-bottom: 5rpx;
}

.recognize-button {
  margin-top: 20rpx;
}

.empty-upload {
  text-align: center;
  padding: 70rpx 34rpx 20rpx;
}

.empty-upload-title {
  font-size: 28rpx;
  font-weight: 680;
  margin-bottom: 8rpx;
}
